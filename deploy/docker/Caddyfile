{
	admin off
	default_sni {$PD_WECHAT_HTTPS_HOST}
}

{$PD_WECHAT_HTTPS_HOST} {
	encode zstd gzip
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# The phone uses the same trusted HTTPS origin without exposing 8088.
	redir /observatory /observatory/ 308
	handle_path /observatory/* {
		reverse_proxy observatory:8088
	}
	handle {
		reverse_proxy gateway:19090
	}
}
