TZ=Asia/Shanghai

COMPOSE_PROJECT_NAME=pd-wechat-runtime
PD_WECHAT_RUNTIME_NETWORK=pd-wechat-runtime_default

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password

OBS_DB_NAME=wechat_observatory
OBS_DB_USER=wechat_observatory
OBS_DB_PASSWORD=replace-with-an-observatory-db-password
GATEWAY_DB_NAME=pd_wechat_gateway
GATEWAY_DB_USER=pd_wechat_gateway
GATEWAY_DB_PASSWORD=replace-with-a-gateway-db-password

BRIDGE_ADMIN_PASSWORD=replace-with-an-observatory-admin-password
BRIDGE_DEVICE_ADMIN_PASSWORD=replace-with-a-separate-device-admin-password
BRIDGE_API_KEYS=
BRIDGE_DEFAULT_DEVICE=bootstrap
BRIDGE_DEVICES=bootstrap||Bootstrap Device|5s
BRIDGE_HISTORY_RETENTION_DAYS=15
BRIDGE_HISTORY_RETENTION_INTERVAL=1h
BRIDGE_MODULE_OFFLINE_AFTER=5m
BRIDGE_OFFLINE_OUTBOX_SWEEP_INTERVAL=30s

PD_GATEWAY_SUPER_USERNAME=admin
PD_GATEWAY_SUPER_PASSWORD=replace-with-a-gateway-admin-password
PD_GATEWAY_SUPER_DISPLAY_NAME=Super Admin

# Public Boss/Admin origin. Production must use HTTPS and keep the pepper secret.
PD_WECHAT_HTTPS_HOST=203.0.113.10
PD_GATEWAY_PUBLIC_BASE_URL=https://203.0.113.10
PD_GATEWAY_BOSS_APP_ENABLED=true
PD_GATEWAY_BOSS_DIST=/app/web/boss/dist
PD_GATEWAY_BOSS_COOKIE_SECURE=true
PD_GATEWAY_BOSS_KEY_PEPPER=replace-with-at-least-32-random-characters
PD_GATEWAY_BOSS_PUSH_ENABLED=false
PD_GATEWAY_BOSS_PUSH_VAPID_PUBLIC=
PD_GATEWAY_BOSS_PUSH_VAPID_PRIVATE=
PD_GATEWAY_BOSS_PUSH_VAPID_SUBJECT=

# Initial cutover keeps exactly one configured tea-house account owner.
PD_GATEWAY_GAME_RUNTIME_ENABLED=false
PD_GATEWAY_RUNTIME_TEAHOUSE_ID=
PD_GATEWAY_PLAYER_CONTROLS_ENABLED=false
PD_GATEWAY_NATIVE_COMMANDS_ENABLED=false
PD_GATEWAY_NATIVE_COMMAND_HOUSE_GIDS=
PD_GATEWAY_NATIVE_HOUSE_USER_GIDS=
PD_GATEWAY_ALL_COMMANDS_ENABLED=false
PD_GATEWAY_WEALTH_ENABLED=false
PD_GATEWAY_WEALTH_HOUSE_GIDS=

PD_GATEWAY_HISTORY_RETENTION_DAYS=30
PD_GATEWAY_HISTORY_RETENTION_INTERVAL=1h
PD_GATEWAY_RESOURCE_ALERTS_ENABLED=true
PD_GATEWAY_RESOURCE_ALERT_INTERVAL=5m
PD_GATEWAY_RESOURCE_ALERT_COOLDOWN=6h
PD_GATEWAY_DATABASE_ALERT_BYTES=5368709120
PD_GATEWAY_BINLOG_ALERT_BYTES=4294967296
PD_GATEWAY_DISK_ALERT_PERCENT=85
PD_GATEWAY_MEMORY_ALERT_PERCENT=85
